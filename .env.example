# Required for live runs (not needed for pytest / --dry-run with fakes)
REMARKABLE_TOKEN=
ANTHROPIC_API_KEY=

# Optional overrides
REMARKABLE_NOTEBOOK_NAME=Daily Journal
REMARKABLE_PAGE_COUNT=5
WEEKLY_CATEGORIES=To-Dos,Meeting Notes,Follow-ups,Other
WEEKLY_NOTES_DIR=weekly-notes
ANTHROPIC_MODEL=claude-sonnet-4-6
CHUNK_MAX_HEIGHT=1400
# local = machine local timezone; UTC = use UTC for generated timestamps
WEEKLY_NOTES_TZ=local
